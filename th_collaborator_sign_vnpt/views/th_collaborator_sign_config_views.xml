<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="th_collaborator_sign_vnpt_sign_config_form_view" model="ir.ui.view">
        <field name="name">th.collaborator.sign.config.form.vnpt</field>
        <field name="model">th.collaborator.sign.config</field>
        <field name="inherit_id" ref="th_collaborator.th_collaborator_sign_config_form_view"/>
        <field name="arch" type="xml">
            <field name="th_provider" position="after">
                <field name="th_vnpt_license_key"
                       attrs="{'invisible': [('th_provider', '!=', 'vnpt_plugin')],
                               'required': [('th_provider', '=', 'vnpt_plugin')]}"/>
            </field>
        </field>
    </record>
</odoo>
