<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="th_collaborator_upload_page_template" name="Tải hợp đồng CTV">
        <t t-call="web.frontend_layout">
            <t t-set="title">Tải lên hợp đồng cộng tác viên</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="container py-5" style="max-width: 640px;">
                <h3 class="mb-4">Tải lên hợp đồng cộng tác viên</h3>
                <div t-if="error" class="alert alert-danger" t-out="error"/>
                <div t-if="success" class="alert alert-success" t-out="success"/>
                <form t-if="not success" t-attf-action="/th_collaborator/upload/#{token}/submit"
                      method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label" for="th_phone">Số điện thoại đã đăng ký</label>
                        <input type="tel" class="form-control" id="th_phone" name="th_phone"
                               required="required" t-att-value="th_phone"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="th_contract_files">File hợp đồng</label>
                        <input type="file" class="form-control" id="th_contract_files" name="th_contract_files"
                               multiple="multiple" required="required" t-att-accept="th_accept"/>
                        <div class="form-text">
                            Tối đa <t t-out="th_max_files"/> file, mỗi file không quá <t t-out="th_max_file_size_mb"/>MB
                            (<t t-out="th_accept"/>).
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Gửi hợp đồng</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
