<odoo>
    <record id="view_res_config_settings_formio_extend" model="ir.ui.view">
        <field name="name">res.config.settings.formio.view.form.inherit.th_form_manager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="formio.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='formio']/h2[1]" position="before">
                <div class="app_settings_block" string="Forms" data-string="Forms" data-key="formio">
                    <h2>Người duyệt form</h2>
                    <div class="row mt16 o_settings_container" name="formio_approver">
                        <div class="row">
                            <label for="th_form_manager_ids" string="Chọn người duyệt form"/>
                            <field name="th_form_manager_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
