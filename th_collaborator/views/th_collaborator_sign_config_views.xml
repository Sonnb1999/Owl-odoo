<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="th_collaborator_sign_config_tree_view" model="ir.ui.view">
        <field name="name">th.collaborator.sign.config.tree</field>
        <field name="model">th.collaborator.sign.config</field>
        <field name="arch" type="xml">
            <tree string="Cấu hình ký số">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="th_provider"/>
                <field name="th_appearance_type"/>
            </tree>
        </field>
    </record>

    <record id="th_collaborator_sign_config_form_view" model="ir.ui.view">
        <field name="name">th.collaborator.sign.config.form</field>
        <field name="model">th.collaborator.sign.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình ký số">
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên cấu hình ký số" required="1"/></h1>
                    </div>
                    <group>
                        <group name="th_provider_group" string="Nhà cung cấp">
                            <field name="th_provider" required="1"/>
                            <field name="th_tsa_url"/>
                        </group>
                        <group string="Hiển thị chữ ký">
                            <field name="th_appearance_type" required="1"/>
                            <field name="th_image" widget="image" class="oe_avatar"
                                   attrs="{'invisible': [('th_appearance_type', 'not in', ['description_image', 'image'])],
                                           'required': [('th_appearance_type', 'in', ['description_image', 'image'])]}"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('th_appearance_type', 'in', ['image', 'invisible'])]}">
                        <group string="Thông tin hiển thị">
                            <field name="th_is_signer_visible"/>
                            <field name="th_is_email_visible"/>
                            <field name="th_is_position_visible"/>
                            <field name="th_is_signing_time_visible"/>
                        </group>
                        <group string="Định dạng">
                            <field name="th_description" placeholder="Ký bởi: CÔNG TY ABC&#10;Thời gian ký: {thoi_gian}"/>
                            <field name="th_text_size"/>
                            <field name="th_text_color" widget="color"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tuỳ chọn khác">
                            <field name="th_is_initial_all_pages"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="th_collaborator_sign_config_action" model="ir.actions.act_window">
        <field name="name">Cấu hình ký số</field>
        <field name="res_model">th.collaborator.sign.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
