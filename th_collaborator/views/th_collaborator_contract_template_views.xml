<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="th_collaborator_contract_template_tree_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.template.tree</field>
        <field name="model">th.collaborator.contract.template</field>
        <field name="arch" type="xml">
            <tree string="Template hợp đồng">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="th_contract_type_ids" widget="many2many_tags" options="{'color_field': 'th_color'}"/>
                <field name="th_detected_field_names"/>
                <field name="th_mail_template_id"/>
            </tree>
        </field>
    </record>

    <record id="th_collaborator_contract_template_form_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.template.form</field>
        <field name="model">th.collaborator.contract.template</field>
        <field name="arch" type="xml">
            <form string="Template hợp đồng">
                <header>
                    <button name="th_action_preview_template" type="object" string="Xem thử với dữ liệu mẫu"
                            class="oe_highlight" attrs="{'invisible': [('th_template_file', '=', False)]}"/>
                    <button name="th_action_open_designer" type="object" string="Thiết kế ô đục lỗ"
                            attrs="{'invisible': [('th_template_file', '=', False)]}"/>
                    <button name="th_action_sync_field_lines" type="object" string="Đọc lại ô form"
                            attrs="{'invisible': [('th_template_file', '=', False)]}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên template hợp đồng" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="th_template_filename" invisible="1"/>
                            <field name="th_template_file" filename="th_template_filename" required="1"
                                   options="{'accepted_file_extensions': '.pdf'}"/>
                            <field name="th_detected_field_names"/>
                        </group>
                        <group>
                            <field name="th_sign_config_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="th_mail_template_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="th_contract_type_ids" widget="many2many_tags"
                                   options="{'color_field': 'th_color', 'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cấu hình đục lỗ" name="th_field_lines">
                            <field name="th_field_line_ids">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="th_pdf_field_name" readonly="1"/>
                                    <field name="th_field_name"/>
                                    <field name="th_is_manual" readonly="1"/>
                                    <field name="th_is_signature" readonly="1"/>
                                    <field name="th_page" readonly="1"
                                           attrs="{'invisible': [('th_is_manual', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="th_collaborator_contract_template_search_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.template.search</field>
        <field name="model">th.collaborator.contract.template</field>
        <field name="arch" type="xml">
            <search string="Template hợp đồng">
                <field name="name"/>
                <field name="th_contract_type_ids"/>
                <filter name="th_filter_archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="th_collaborator_contract_template_action" model="ir.actions.act_window">
        <field name="name">Template hợp đồng</field>
        <field name="res_model">th.collaborator.contract.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="th_collaborator_contract_template_search_view"/>
    </record>

    <!-- Cấu hình nội dung mail gửi hợp đồng: dùng form mẫu email chuẩn của Odoo -->
    <record id="th_collaborator_mail_template_action" model="ir.actions.act_window">
        <field name="name">Mẫu email hợp đồng</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('model', '=', 'th.collaborator.profile')]</field>
        <field name="context" eval="{'default_model_id': ref('th_collaborator.model_th_collaborator_profile')}"/>
    </record>
</odoo>
