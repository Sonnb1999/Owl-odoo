<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="th_collaborator_profile_upload_mail_template" model="mail.template">
            <field name="name">CTV: Mời tải hợp đồng</field>
            <field name="model_id" ref="model_th_collaborator_profile"/>
            <field name="subject">[{{ object.env.company.name }}] Hợp đồng cộng tác viên - {{ object.name }}</field>
            <field name="email_from">{{ object.user_id.email_formatted }}</field>
            <field name="reply_to">{{ object.user_id.email_formatted }}</field>
            <field name="email_to">{{ object.th_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p>Xin chào <strong t-out="object.name or ''">CTV</strong>,</p>
    <p>Công ty gửi bạn hợp đồng cộng tác viên (đính kèm, nếu có).</p>
    <p>Sau khi ký, bạn vui lòng tải hợp đồng lên qua đường link bên dưới. Khi tải lên, hãy nhập đúng số điện thoại bạn đã đăng ký với chúng tôi.</p>
    <p style="margin: 24px 0px;">
        <a t-att-href="object.th_upload_url"
           style="background-color: #714B67; padding: 10px 18px; color: #FFFFFF; text-decoration: none; border-radius: 4px;">
            Tải lên hợp đồng
        </a>
    </p>
    <p>Trân trọng,<br/><t t-out="object.env.company.name or ''"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
